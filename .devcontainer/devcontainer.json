{
  "name": "Thunder Cloud Linux Desktop",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "hostRequirements": {"cpus": 4, "memory": "16gb", "storage": "32gb"},
  "forwardPorts": [3389],
  "portsAttributes": {"3389": {"label": "ThunderRemote RDP (private)", "visibility": "private", "onAutoForward": "notify"}},
  "postCreateCommand": "sudo bash .devcontainer/setup.sh",
  "postStartCommand": "sudo /usr/local/bin/thunder-start-desktop",
  "remoteUser": "vscode",
  "containerEnv": {"DISPLAY": ":10"}
}
